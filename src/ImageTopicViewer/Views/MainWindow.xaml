<Window x:Class="ImageTopicViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ImageTopicViewer.Views"
        xmlns:vm="clr-namespace:ImageTopicViewer.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1000" Height="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 툴바: 연속보기/단일보기 토글 (06-view-modes.md) -->
        <Border Grid.Row="0" Padding="8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <!-- 맨 앞: 현재 페이지 번호(1부터) / 전체. 입력해서 이동 가능 (07-ui-layout.md). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ContinuousPage.ShowImages, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox x:Name="PageNumberTextBox" Width="45" TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding ContinuousPage.CurrentPageNumber, Mode=TwoWay}"
                             KeyDown="PageNumberTextBox_KeyDown"
                             GotFocus="PageNumberTextBox_GotFocus"/>
                    <TextBlock VerticalAlignment="Center" Margin="4,0,0,0">
                        <Run Text="/"/>
                        <Run Text="{Binding ContinuousPage.Images.Count, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Content="{Binding ViewModeToggleLabel}"
                        Command="{Binding ToggleViewModeCommand}"
                        Padding="8,4"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="크기:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{x:Static vm:ContinuousPageViewModel.ZoomOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Percent"
                              SelectedValue="{Binding ContinuousPage.ZoomPercent, Mode=TwoWay}"
                              Width="90"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSingleView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Button Content="맨 위로" Padding="8,4" Margin="0,0,4,0"
                            Command="{Binding ContinuousPage.ScrollToTopCommand}"/>
                    <Button Content="맨 아래로" Padding="8,4"
                            Command="{Binding ContinuousPage.ScrollToBottomCommand}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSingleView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="스크롤 속도:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{x:Static vm:ContinuousPageViewModel.ScrollSpeedOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Multiplier"
                              SelectedValue="{Binding ContinuousPage.ScrollSpeedMultiplier, Mode=TwoWay}"
                              Width="60"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 패널: 주제 트리 (04-topic-management.md) -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                <views:TopicTreeView DataContext="{Binding TopicTree}"/>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

            <!-- 메인 영역: 연속보기/단일보기 (06-view-modes.md, 07-ui-layout.md). 둘 다 같은 ContinuousPageViewModel을 공유해 이미지 위치를 유지한다. -->
            <Grid Grid.Column="2">
                <views:ContinuousPageView DataContext="{Binding ContinuousPage}"
                                          Visibility="{Binding DataContext.IsSingleView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <views:SingleImageView DataContext="{Binding ContinuousPage}"
                                       Visibility="{Binding DataContext.IsSingleView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
