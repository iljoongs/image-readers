<Window x:Class="ImageTopicViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageTopicViewer"
        Width="1000" Height="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 툴바 (연속보기/단일보기 토글은 M7에서 추가) -->
        <Border Grid.Row="0" Padding="8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <TextBlock Text="ImageTopicViewer" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 패널: 주제 트리는 M2에서 추가, 지금은 데이터 폴더 경로만 표시 -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                <StackPanel Margin="8">
                    <TextBlock Text="데이터 폴더" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DataFolderPath}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

            <!-- 메인 영역: 연속보기/단일보기는 M3, M7에서 추가 -->
            <TextBlock Grid.Column="2" Text="좌측에서 주제를 선택하세요"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#888888"/>
        </Grid>
    </Grid>
</Window>
