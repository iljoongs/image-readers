<Window x:Class="ImageTopicViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ImageTopicViewer.Views"
        xmlns:vm="clr-namespace:ImageTopicViewer.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1000" Height="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 홈 화면(대주제 카드 그리드, sample.png 참고): 앱 실행 시 맨 처음 보이는 화면이다 (07-ui-layout.md "홈 화면").
             카드를 클릭하면 숨겨지고 아래 기존 화면(툴바+트리+뷰어)이 드러난다. -->
        <views:HomeView Grid.Row="0" Grid.RowSpan="2"
                         Visibility="{Binding IsHomeScreen, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- 기존 화면(툴바+트리+뷰어) 전체를 하나로 묶어 홈 화면일 때 통째로 숨긴다. -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsHomeScreen, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단 메뉴: 2026-10-24 툴바(버튼 나열)를 메뉴로 전환했다 — 홈/정렬/스크롤/이동/보기
                 (06-view-modes.md, 07-ui-layout.md "상단 메뉴"). -->
            <Border Grid.Row="0" Padding="0,2" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="홈" Command="{Binding GoHomeCommand}"/>

                        <!-- 정렬: Windows 파일 탐색기의 "정렬 기준" 메뉴와 같은 구조 — 기준(이름/평점)과
                             방향(오름차순/내림차순)을 따로 고른다. -->
                        <MenuItem Header="정렬">
                            <MenuItem Header="이름" IsCheckable="True"
                                      IsChecked="{Binding TopicTree.IsSortByName, Mode=OneWay}"
                                      Command="{Binding TopicTree.SetSortKeyCommand}"
                                      CommandParameter="{x:Static vm:TopicSortKey.Name}"/>
                            <MenuItem Header="평점" IsCheckable="True"
                                      IsChecked="{Binding TopicTree.IsSortByRating, Mode=OneWay}"
                                      Command="{Binding TopicTree.SetSortKeyCommand}"
                                      CommandParameter="{x:Static vm:TopicSortKey.Rating}"/>
                            <Separator/>
                            <MenuItem Header="오름차순" IsCheckable="True"
                                      IsChecked="{Binding TopicTree.IsSortAscending, Mode=OneWay}"
                                      Command="{Binding TopicTree.SetSortAscendingCommand}"/>
                            <MenuItem Header="내림차순" IsCheckable="True"
                                      IsChecked="{Binding TopicTree.IsSortDescending, Mode=OneWay}"
                                      Command="{Binding TopicTree.SetSortDescendingCommand}"/>
                        </MenuItem>

                        <!-- 스크롤: 연속보기 마우스 휠 배속 x1~x10, 기본 x6 (06-view-modes.md "연속보기"). -->
                        <MenuItem Header="스크롤" IsEnabled="{Binding IsContinuousView}">
                            <MenuItem Header="x1" IsCheckable="True" CommandParameter="1"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1, Mode=OneWay}"/>
                            <MenuItem Header="x2" IsCheckable="True" CommandParameter="2"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2, Mode=OneWay}"/>
                            <MenuItem Header="x3" IsCheckable="True" CommandParameter="3"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3, Mode=OneWay}"/>
                            <MenuItem Header="x4" IsCheckable="True" CommandParameter="4"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4, Mode=OneWay}"/>
                            <MenuItem Header="x5" IsCheckable="True" CommandParameter="5"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5, Mode=OneWay}"/>
                            <MenuItem Header="x6" IsCheckable="True" CommandParameter="6"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=6, Mode=OneWay}"/>
                            <MenuItem Header="x7" IsCheckable="True" CommandParameter="7"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=7, Mode=OneWay}"/>
                            <MenuItem Header="x8" IsCheckable="True" CommandParameter="8"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=8, Mode=OneWay}"/>
                            <MenuItem Header="x9" IsCheckable="True" CommandParameter="9"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=9, Mode=OneWay}"/>
                            <MenuItem Header="x10" IsCheckable="True" CommandParameter="10"
                                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=10, Mode=OneWay}"/>
                        </MenuItem>

                        <!-- 이동: 연속보기에서만 의미가 있으므로 단일보기에서는 비활성화한다. -->
                        <MenuItem Header="이동" IsEnabled="{Binding IsContinuousView}">
                            <MenuItem Header="맨 위로" Command="{Binding ContinuousPage.ScrollToTopCommand}"/>
                            <MenuItem Header="맨 아래로" Command="{Binding ContinuousPage.ScrollToBottomCommand}"/>
                        </MenuItem>

                        <!-- 보기: 단일보기/이어보기(연속보기) 중 하나를 고른다. -->
                        <MenuItem Header="보기">
                            <MenuItem Header="단일보기" IsCheckable="True"
                                      IsChecked="{Binding IsSingleView, Mode=OneWay}"
                                      Command="{Binding SetSingleViewCommand}"/>
                            <MenuItem Header="이어보기" IsCheckable="True"
                                      IsChecked="{Binding IsContinuousView, Mode=OneWay}"
                                      Command="{Binding SetContinuousViewCommand}"/>
                        </MenuItem>
                    </Menu>

                    <!-- 맨 뒤: 현재 페이지 번호(1부터) / 전체. 직접 입력 가능한 텍스트박스라 메뉴 항목으로
                         바꾸지 않고 그대로 둔다. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                Visibility="{Binding ContinuousPage.ShowImages, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox x:Name="PageNumberTextBox" Width="45" TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ContinuousPage.CurrentPageNumber, Mode=TwoWay}"
                                 KeyDown="PageNumberTextBox_KeyDown"
                                 GotFocus="PageNumberTextBox_GotFocus"/>
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,0">
                            <Run Text="/"/>
                            <Run Text="{Binding ContinuousPage.Images.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측 패널: 주제 트리 (04-topic-management.md) -->
                <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                    <views:TopicTreeView DataContext="{Binding TopicTree}"/>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

                <!-- 메인 영역: 연속보기/단일보기 (06-view-modes.md, 07-ui-layout.md). 둘 다 같은 ContinuousPageViewModel을 공유해 이미지 위치를 유지한다. -->
                <Grid Grid.Column="2">
                    <views:ContinuousPageView DataContext="{Binding ContinuousPage}"
                                              Visibility="{Binding DataContext.IsSingleView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <views:SingleImageView DataContext="{Binding ContinuousPage}"
                                           Visibility="{Binding DataContext.IsSingleView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Ctrl+스크롤로 확대/축소할 때 Microsoft Edge처럼 상단에 잠깐 떠 있는 배율 팝업
                         (06-view-modes.md "확대/축소"). ContinuousPageViewModel.IsZoomIndicatorVisible이
                         조작 시 켜지고 일정 시간 뒤 꺼진다. -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                            Background="#CC202020" CornerRadius="18" Padding="6,2"
                            Visibility="{Binding ContinuousPage.IsZoomIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-" Width="30" Height="30" Padding="0" FontSize="16" FontWeight="Bold"
                                    Background="Transparent" Foreground="White" BorderThickness="0"
                                    Command="{Binding ContinuousPage.ZoomOutCommand}"/>
                            <TextBlock Text="{Binding ContinuousPage.ZoomPercent, StringFormat={}{0:0}%}"
                                       Foreground="White" FontSize="13" Width="48" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Button Content="+" Width="30" Height="30" Padding="0" FontSize="16" FontWeight="Bold"
                                    Background="Transparent" Foreground="White" BorderThickness="0"
                                    Command="{Binding ContinuousPage.ZoomInCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
