<Window x:Class="ImageTopicViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ImageTopicViewer.Views"
        Title="ImageTopicViewer"
        Width="1000" Height="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 툴바 (연속보기/단일보기 토글은 M7에서 추가) -->
        <Border Grid.Row="0" Padding="8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <TextBlock Text="ImageTopicViewer" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 패널: 주제 트리 (04-topic-management.md) -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                <views:TopicTreeView DataContext="{Binding TopicTree}"/>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

            <!-- 메인 영역: 연속보기 (07-ui-layout.md). 단일보기는 M7에서 추가 -->
            <views:ContinuousPageView Grid.Column="2" DataContext="{Binding ContinuousPage}"/>
        </Grid>
    </Grid>
</Window>
