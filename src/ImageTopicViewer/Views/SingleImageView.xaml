<UserControl x:Class="ImageTopicViewer.Views.SingleImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="White" Focusable="True"
          PreviewKeyDown="Root_PreviewKeyDown"
          IsVisibleChanged="Root_IsVisibleChanged">

        <TextBlock Text="좌측에서 주제를 선택하세요"
                   Visibility="{Binding ShowNoSelectionMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#888888"/>

        <TextBlock Text="이미지를 여기로 드래그하세요"
                   Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#888888"/>

        <Grid Visibility="{Binding ShowImages, Converter={StaticResource BoolToVisibilityConverter}}">
            <Image Source="{Binding CurrentItem.Image}" Stretch="Uniform" Margin="60,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PreviousArea" Grid.Column="0" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="PreviousArea_MouseLeftButtonUp">
                    <TextBlock Text="&#8249;" FontSize="56" Foreground="Black"
                               HorizontalAlignment="Left" Margin="24,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Opacity="0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=PreviousArea}" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border x:Name="NextArea" Grid.Column="1" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="NextArea_MouseLeftButtonUp">
                    <TextBlock Text="&#8250;" FontSize="56" Foreground="Black"
                               HorizontalAlignment="Right" Margin="0,0,24,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Opacity="0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=NextArea}" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
