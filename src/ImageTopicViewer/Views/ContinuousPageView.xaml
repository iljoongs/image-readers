<UserControl x:Class="ImageTopicViewer.Views.ContinuousPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock Text="좌측에서 주제를 선택하세요"
                   Visibility="{Binding ShowNoSelectionMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#888888"/>

        <TextBlock Text="이미지를 여기로 드래그하세요"
                   Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#888888"/>

        <ScrollViewer Visibility="{Binding ShowImages, Converter={StaticResource BoolToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Images}" Margin="16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Image}" Stretch="Uniform"
                               MaxWidth="900" MaxHeight="900"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
