<UserControl x:Class="ImageTopicViewer.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ImageTopicViewer.ViewModels">
    <!-- 상단 메뉴: 홈/정렬/스크롤/이동/보기. MainWindow(뷰어 화면)와 HomeView(홈 화면)가 공유한다
         (07-ui-layout.md "상단 메뉴"). 둘 다 DataContext가 MainViewModel이므로 바인딩 경로가 같다. -->
    <Menu Background="Transparent" VerticalAlignment="Center">
        <MenuItem Header="홈" Command="{Binding GoHomeCommand}"/>

        <!-- 정렬: Windows 파일 탐색기의 "정렬 기준" 메뉴와 같은 구조 — 기준(이름/평점/날짜)과
             방향(오름차순/내림차순)을 따로 고른다. 홈 화면에서도 대주제 카드 순서에 그대로 반영된다. -->
        <MenuItem Header="정렬">
            <MenuItem Header="이름" IsCheckable="True"
                      IsChecked="{Binding TopicTree.IsSortByName, Mode=OneWay}"
                      Command="{Binding TopicTree.SetSortKeyCommand}"
                      CommandParameter="{x:Static vm:TopicSortKey.Name}"/>
            <MenuItem Header="평점" IsCheckable="True"
                      IsChecked="{Binding TopicTree.IsSortByRating, Mode=OneWay}"
                      Command="{Binding TopicTree.SetSortKeyCommand}"
                      CommandParameter="{x:Static vm:TopicSortKey.Rating}"/>
            <MenuItem Header="날짜" IsCheckable="True"
                      IsChecked="{Binding TopicTree.IsSortByDate, Mode=OneWay}"
                      Command="{Binding TopicTree.SetSortKeyCommand}"
                      CommandParameter="{x:Static vm:TopicSortKey.Date}"/>
            <Separator/>
            <MenuItem Header="오름차순" IsCheckable="True"
                      IsChecked="{Binding TopicTree.IsSortAscending, Mode=OneWay}"
                      Command="{Binding TopicTree.SetSortAscendingCommand}"/>
            <MenuItem Header="내림차순" IsCheckable="True"
                      IsChecked="{Binding TopicTree.IsSortDescending, Mode=OneWay}"
                      Command="{Binding TopicTree.SetSortDescendingCommand}"/>
        </MenuItem>

        <!-- 스크롤: 연속보기 마우스 휠 배속 x1~x10, 기본 x6 (06-view-modes.md "연속보기"). 뷰어 화면에서
             연속보기일 때만 활성화 — 홈 화면이거나 단일보기면 비활성화(회색). -->
        <MenuItem Header="스크롤" IsEnabled="{Binding IsContinuousScrollEnabled}">
            <MenuItem Header="x1" IsCheckable="True" CommandParameter="1"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1, Mode=OneWay}"/>
            <MenuItem Header="x2" IsCheckable="True" CommandParameter="2"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2, Mode=OneWay}"/>
            <MenuItem Header="x3" IsCheckable="True" CommandParameter="3"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3, Mode=OneWay}"/>
            <MenuItem Header="x4" IsCheckable="True" CommandParameter="4"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4, Mode=OneWay}"/>
            <MenuItem Header="x5" IsCheckable="True" CommandParameter="5"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5, Mode=OneWay}"/>
            <MenuItem Header="x6" IsCheckable="True" CommandParameter="6"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=6, Mode=OneWay}"/>
            <MenuItem Header="x7" IsCheckable="True" CommandParameter="7"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=7, Mode=OneWay}"/>
            <MenuItem Header="x8" IsCheckable="True" CommandParameter="8"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=8, Mode=OneWay}"/>
            <MenuItem Header="x9" IsCheckable="True" CommandParameter="9"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=9, Mode=OneWay}"/>
            <MenuItem Header="x10" IsCheckable="True" CommandParameter="10"
                      Command="{Binding ContinuousPage.SetScrollSpeedCommand}"
                      IsChecked="{Binding ContinuousPage.ScrollSpeedMultiplier, Converter={StaticResource IntEqualsConverter}, ConverterParameter=10, Mode=OneWay}"/>
        </MenuItem>

        <!-- 이동: 연속보기에서만 의미가 있으므로 홈 화면이거나 단일보기면 비활성화한다. -->
        <MenuItem Header="이동" IsEnabled="{Binding IsContinuousScrollEnabled}">
            <MenuItem Header="맨 위로" Command="{Binding ContinuousPage.ScrollToTopCommand}"/>
            <MenuItem Header="맨 아래로" Command="{Binding ContinuousPage.ScrollToBottomCommand}"/>
        </MenuItem>

        <!-- 보기: 단일보기/이어보기(연속보기) 중 하나를 고른다. 뷰어 화면이 아니면(홈 화면) 비활성화. -->
        <MenuItem Header="보기" IsEnabled="{Binding IsViewerActive}">
            <MenuItem Header="단일보기" IsCheckable="True"
                      IsChecked="{Binding IsSingleView, Mode=OneWay}"
                      Command="{Binding SetSingleViewCommand}"/>
            <MenuItem Header="이어보기" IsCheckable="True"
                      IsChecked="{Binding IsContinuousView, Mode=OneWay}"
                      Command="{Binding SetContinuousViewCommand}"/>
        </MenuItem>
    </Menu>
</UserControl>
