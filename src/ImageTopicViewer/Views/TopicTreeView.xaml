<UserControl x:Class="ImageTopicViewer.Views.TopicTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
            <Button Content="+ 대주제 추가" Padding="4" Margin="0,0,4,0"
                    Command="{Binding AddMajorTopicCommand}"/>
            <Button Content="{Binding SortToggleLabel}" Padding="4"
                    Command="{Binding ToggleSortOrderCommand}"/>
        </StackPanel>

        <TreeView x:Name="Tree" ItemsSource="{Binding Topics}"
                  SelectedItemChanged="Tree_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Grid>
                        <!-- 대주제: progress bar 모양 안에 이름을 표시한다. 채움 폭은 Progress(1~10)에 비례하고,
                             채움 색은 game-platform 프로젝트의 평점 슬라이더처럼 값 구간별로 바뀐다
                             (07-ui-layout.md "좌측 패널", 04-topic-management.md "진행도 설정"). -->
                        <Grid Margin="2" MinHeight="24"
                              Visibility="{Binding IsMajorTopic, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressStarWidthConverter}, ConverterParameter=Fill}"/>
                                <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressStarWidthConverter}, ConverterParameter=Empty}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="11" Background="#E3E3E3"/>
                            <Border Grid.Column="0" CornerRadius="11,0,0,11"
                                    Background="{Binding Progress, Converter={StaticResource MajorTopicProgressColorConverter}}"/>
                            <TextBlock Grid.ColumnSpan="2" Text="{Binding Name, Mode=OneWay}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="10,3" Foreground="White" FontWeight="SemiBold"
                                       MaxWidth="{Binding ActualWidth, ElementName=Tree, Converter={StaticResource WidthMinusMarginConverter}, ConverterParameter=48}"/>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="소주제 추가" Click="AddMinorTopicMenuItem_Click"/>
                                    <MenuItem Header="진행도 설정" Click="SetProgressMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="이름변경" Click="RenameTopicMenuItem_Click"/>
                                    <MenuItem Header="삭제" Click="DeleteTopicMenuItem_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                        </Grid>

                        <!-- 소주제: 기존과 동일한 한 줄 텍스트 표시 -->
                        <TextBlock Padding="2"
                                   Visibility="{Binding IsMajorTopic, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text="{Binding ProgressLabel, Mode=OneWay}" Foreground="Gray"/>
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="이름변경" Click="RenameTopicMenuItem_Click"/>
                                    <MenuItem Header="삭제" Click="DeleteTopicMenuItem_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
