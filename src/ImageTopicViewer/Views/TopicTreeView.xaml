<UserControl x:Class="ImageTopicViewer.Views.TopicTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
            <Button Content="+ 대주제 추가" Padding="4" Margin="0,0,4,0"
                    Command="{Binding AddMajorTopicCommand}"/>
            <Button Content="{Binding SortToggleLabel}" Padding="4"
                    Command="{Binding ToggleSortOrderCommand}"/>
        </StackPanel>

        <TreeView x:Name="Tree" ItemsSource="{Binding Topics}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectedItemChanged="Tree_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Grid>
                        <!-- 대주제: progress bar 모양 안에 이름을 표시한다. 채움 폭은 Rating(1~10)에 비례하고,
                             채움 색은 game-platform 프로젝트의 평점 슬라이더처럼 값 구간별로 바뀐다
                             (07-ui-layout.md "좌측 패널", 04-topic-management.md "평점 설정").
                             Width를 명시적으로 걸어야 줄바꿈이 실제로 동작한다 — TreeView의 아이템 패널은
                             가상화 때문에 가로 방향을 항상 무한대로 측정해서, HorizontalScrollBarVisibility만
                             "Disabled"로 바꿔서는 줄바꿈도 안 되고 폭도 안 줄어든다(그래서 스크롤바는 사라져도
                             텍스트가 중간에서 잘렸다 — 2026-09-14 확인). ScrollViewer.HorizontalScrollBarVisibility
                             ="Disabled"는 이 Width 계산이 1~2px 어긋나도 스크롤바가 절대 뜨지 않게 하는 안전장치로 남겨둔다. -->
                        <Grid Margin="2" MinHeight="24"
                              Width="{Binding ActualWidth, ElementName=Tree, Converter={StaticResource WidthMinusMarginConverter}, ConverterParameter=56}"
                              Visibility="{Binding IsMajorTopic, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Rating, Converter={StaticResource RatingStarWidthConverter}, ConverterParameter=Fill}"/>
                                <ColumnDefinition Width="{Binding Rating, Converter={StaticResource RatingStarWidthConverter}, ConverterParameter=Empty}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="11" Background="#E3E3E3"/>
                            <Border Grid.Column="0" CornerRadius="11,0,0,11"
                                    Background="{Binding Rating, Converter={StaticResource MajorTopicRatingColorConverter}}"/>
                            <TextBlock Grid.ColumnSpan="2" Text="{Binding Name, Mode=OneWay}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="10,3" Foreground="White" FontWeight="SemiBold"/>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="소주제 추가" Click="AddMinorTopicMenuItem_Click"/>
                                    <MenuItem Header="평점 설정" Click="SetRatingMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="이름변경" Click="RenameTopicMenuItem_Click"/>
                                    <MenuItem Header="삭제" Click="DeleteTopicMenuItem_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                        </Grid>

                        <!-- 소주제: 한 줄 텍스트 표시. 가로 스크롤이 없으므로 폭을 넘으면 말줄임표로 자른다
                             (2026-09-14 변경 — 이전엔 가로 스크롤로 봤지만, 대주제 진행도 막대 도입으로 트리의
                             가로 스크롤 자체를 껐다). 말줄임표가 실제로 동작하려면 대주제와 같은 이유로
                             Width를 명시적으로 걸어야 한다. -->
                        <TextBlock Padding="2" TextTrimming="CharacterEllipsis"
                                   Width="{Binding ActualWidth, ElementName=Tree, Converter={StaticResource WidthMinusMarginConverter}, ConverterParameter=56}"
                                   Visibility="{Binding IsMajorTopic, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text="{Binding ProgressLabel, Mode=OneWay}" Foreground="Gray"/>
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="이름변경" Click="RenameTopicMenuItem_Click"/>
                                    <MenuItem Header="삭제" Click="DeleteTopicMenuItem_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
