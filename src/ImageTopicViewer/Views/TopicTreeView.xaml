<UserControl x:Class="ImageTopicViewer.Views.TopicTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
            <Button Content="+ 대주제 추가" Padding="4" Margin="0,0,4,0"
                    Command="{Binding AddMajorTopicCommand}"/>
            <Button Content="{Binding SortToggleLabel}" Padding="4"
                    Command="{Binding ToggleSortOrderCommand}"/>
        </StackPanel>

        <TreeView x:Name="Tree" ItemsSource="{Binding Topics}"
                  SelectedItemChanged="Tree_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Padding="2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMajorTopic}" Value="True">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="MaxWidth">
                                            <Setter.Value>
                                                <Binding ElementName="Tree" Path="ActualWidth"
                                                         Converter="{StaticResource WidthMinusMarginConverter}"
                                                         ConverterParameter="40"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Name, Mode=OneWay}"/>
                        <Run Text="{Binding ProgressLabel, Mode=OneWay}" Foreground="Gray"/>
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="소주제 추가"
                                          Click="AddMinorTopicMenuItem_Click"
                                          Visibility="{Binding IsMajorTopic, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Separator Visibility="{Binding IsMajorTopic, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <MenuItem Header="이름변경" Click="RenameTopicMenuItem_Click"/>
                                <MenuItem Header="삭제" Click="DeleteTopicMenuItem_Click"/>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
