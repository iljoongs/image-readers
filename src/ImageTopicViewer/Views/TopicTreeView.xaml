<UserControl x:Class="ImageTopicViewer.Views.TopicTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="+ 대주제 추가" Margin="4" Padding="4"
                Command="{Binding AddMajorTopicCommand}"/>

        <TreeView x:Name="Tree" ItemsSource="{Binding Topics}"
                  SelectedItemChanged="Tree_SelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" Padding="2">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="소주제 추가"
                                          Click="AddMinorTopicMenuItem_Click"
                                          Visibility="{Binding IsMajorTopic, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
