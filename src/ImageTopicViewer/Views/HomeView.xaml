<UserControl x:Class="ImageTopicViewer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <!-- Ctrl+스크롤 확대/축소(Microsoft Edge 단계, MainViewModel.HomeZoomLevels)를 여기서 가로챈다. -->
        <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="RootScrollViewer_PreviewMouseWheel">
            <!-- LayoutTransform: 측정/배치 단계에서부터 스케일이 적용되어 WrapPanel이 커지거나 작아진 카드
                 크기에 맞춰 다시 줄바꿈한다(RenderTransform은 그려진 뒤에만 늘리므로 줄바꿈이 안 맞음). -->
            <ItemsControl ItemsSource="{Binding TopicTree.Topics}" Margin="20">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding HomeZoomScale}" ScaleY="{Binding HomeZoomScale}"/>
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 대주제 카드: 썸네일(라운드 엣지, 185x260 기본 크기) + 제목/장르/화수
                             (sample.png 참고, 07-ui-layout.md "홈 화면"). 썸네일 위로 이미지를 드래그 앤 드롭해도
                             지정된다(game-platform 프로젝트의 Card_DragOver/Card_Drop과 동일한 방식,
                             DragDropImageHelper 그대로 가져옴). -->
                        <Border Width="185" Margin="10" Cursor="Hand"
                                MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                AllowDrop="True" DragOver="Card_DragOver" Drop="Card_Drop">
                            <StackPanel>
                                <Border CornerRadius="12" Width="185" Height="260"
                                        Background="{Binding ThumbnailPath, Converter={StaticResource ThumbnailBrushConverter}, ConverterParameter=370}"/>
                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" Width="185" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding Genre, Mode=OneWay}" Foreground="Gray" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Width="185"/>
                                <TextBlock FontSize="11" Foreground="#2E6FDB" Margin="0,2,0,0">
                                    <Run Text="{Binding EpisodeCount, Mode=OneWay}"/>
                                    <Run Text="화"/>
                                </TextBlock>
                            </StackPanel>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="평점 설정" Click="SetRatingMenuItem_Click"/>
                                    <MenuItem Header="장르 설정" Click="SetGenreMenuItem_Click"/>
                                    <MenuItem Header="썸네일 설정" Click="SetThumbnailMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="이름변경" Click="RenameTopicMenuItem_Click"/>
                                    <MenuItem Header="삭제" Click="DeleteTopicMenuItem_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
