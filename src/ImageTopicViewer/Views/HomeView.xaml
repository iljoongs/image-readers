<UserControl x:Class="ImageTopicViewer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageTopicViewer.Views">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 메뉴: 뷰어 화면(MainWindow)과 같은 메뉴를 홈 화면에도 둔다(2026-10-24 — 07-ui-layout.md
             "상단 메뉴"). "스크롤"/"이동"/"보기"는 뷰어가 없는 홈 화면에서는 비활성화된다. -->
        <Border Grid.Row="0" Padding="0,2" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <views:MainMenuView/>
        </Border>

        <Grid Grid.Row="1">
        <!-- Ctrl+스크롤 확대/축소(Microsoft Edge 단계, EdgeZoomLevels)를 여기서 가로챈다. -->
        <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="RootScrollViewer_PreviewMouseWheel">
            <!-- LayoutTransform: 측정/배치 단계에서부터 스케일이 적용되어 WrapPanel이 커지거나 작아진 카드
                 크기에 맞춰 다시 줄바꿈한다(RenderTransform은 그려진 뒤에만 늘리므로 줄바꿈이 안 맞음). -->
            <ItemsControl ItemsSource="{Binding TopicTree.Topics}" Margin="20">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding HomeZoomScale}" ScaleY="{Binding HomeZoomScale}"/>
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 대주제 카드: 썸네일(라운드 엣지, 185x260 기본 크기) + 제목/장르/화수
                             (sample.png 참고, 07-ui-layout.md "홈 화면"). 썸네일 위로 이미지를 드래그 앤 드롭해도
                             지정된다(game-platform 프로젝트의 Card_DragOver/Card_Drop과 동일한 방식,
                             DragDropImageHelper 그대로 가져옴). -->
                        <!-- Background="Transparent": Border/Panel은 Background가 null이면 자기 영역 중
                             자식이 덮지 않은 빈 칸(썸네일 밑 글자 사이 여백 등)에서는 히트테스트가 안 돼
                             드래그 드롭/클릭이 씹힌다 — game-platform 카드의 Border.Style도 Background를
                             Transparent로 깔아 카드 전체를 받는다(2026-10-19 확인: 이 한 줄이 빠져 있었다). -->
                        <Border Width="185" Margin="10" Cursor="Hand" Background="Transparent"
                                MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                AllowDrop="True" DragOver="Card_DragOver" Drop="Card_Drop">
                            <StackPanel>
                                <Border CornerRadius="12" Width="185" Height="260"
                                        Background="{Binding ThumbnailPath, Converter={StaticResource ThumbnailBrushConverter}, ConverterParameter=370}"/>
                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" Width="185" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding Genre, Mode=OneWay}" Foreground="Gray" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Width="185"/>
                                <TextBlock FontSize="11" Foreground="#2E6FDB" Margin="0,2,0,0">
                                    <Run Text="{Binding EpisodeCount, Mode=OneWay}"/>
                                    <Run Text="화"/>
                                </TextBlock>
                            </StackPanel>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="평점 설정" Click="SetRatingMenuItem_Click"/>
                                    <MenuItem Header="장르 설정" Click="SetGenreMenuItem_Click"/>
                                    <MenuItem Header="썸네일 설정" Click="SetThumbnailMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="이름변경" Click="RenameTopicMenuItem_Click"/>
                                    <MenuItem Header="삭제" Click="DeleteTopicMenuItem_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Ctrl+스크롤로 홈 화면 배율을 바꿀 때 Microsoft Edge처럼 상단에 잠깐 떠 있는 배율 팝업
             (07-ui-layout.md "홈 화면"). MainViewModel.IsHomeZoomIndicatorVisible이 조작 시 켜지고
             일정 시간 뒤 꺼진다. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                Background="#CC202020" CornerRadius="18" Padding="6,2"
                Visibility="{Binding IsHomeZoomIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="-" Width="30" Height="30" Padding="0" FontSize="16" FontWeight="Bold"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Command="{Binding ZoomHomeOutCommand}"/>
                <TextBlock Text="{Binding HomeZoomPercent, StringFormat={}{0:0}%}"
                           Foreground="White" FontSize="13" Width="48" TextAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Content="+" Width="30" Height="30" Padding="0" FontSize="16" FontWeight="Bold"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Command="{Binding ZoomHomeInCommand}"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
