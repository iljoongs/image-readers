<UserControl x:Class="ImageTopicViewer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding TopicTree.Topics}" Margin="20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 대주제 카드: 커버(라운드 엣지) + 제목/장르/화수 (sample.png 참고, 07-ui-layout.md "홈 화면"). -->
                        <Border Width="150" Margin="10" Cursor="Hand"
                                MouseLeftButtonUp="Card_MouseLeftButtonUp">
                            <StackPanel>
                                <Border CornerRadius="12" Width="150" Height="150"
                                        Background="{Binding CoverImagePath, Converter={StaticResource CoverImageBrushConverter}}"/>
                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" Width="150" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding Genre, Mode=OneWay}" Foreground="Gray" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Width="150"/>
                                <TextBlock FontSize="11" Foreground="#2E6FDB" Margin="0,2,0,0">
                                    <Run Text="{Binding EpisodeCount, Mode=OneWay}"/>
                                    <Run Text="화"/>
                                </TextBlock>
                            </StackPanel>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="평점 설정" Click="SetRatingMenuItem_Click"/>
                                    <MenuItem Header="장르 설정" Click="SetGenreMenuItem_Click"/>
                                    <MenuItem Header="커버 이미지 설정" Click="SetCoverMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="이름변경" Click="RenameTopicMenuItem_Click"/>
                                    <MenuItem Header="삭제" Click="DeleteTopicMenuItem_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
