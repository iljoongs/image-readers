<Application x:Class="ImageTopicViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ImageTopicViewer.Converters">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <conv:WidthMinusMarginConverter x:Key="WidthMinusMarginConverter"/>
        <conv:MajorTopicRatingColorConverter x:Key="MajorTopicRatingColorConverter"/>
        <conv:RatingStarWidthConverter x:Key="RatingStarWidthConverter"/>
        <conv:ThumbnailBrushConverter x:Key="ThumbnailBrushConverter"/>
        <conv:IntEqualsConverter x:Key="IntEqualsConverter"/>
    </Application.Resources>
</Application>
